    const wm=NUM(f.w_mm,0);if(wm>=300&&wm<=4000){if(type==="bed"&&(wall==="left"||wall==="right"))d=CL(wm,900,1800);else w=wm;}
    if(w>Wroom*.7){w=Wroom*.7;}
