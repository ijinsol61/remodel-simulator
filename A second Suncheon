function readImg(f){return new Promise((ok,no)=>{if(!f||!f.type.startsWith("image/"))return no(new Error("이미지 파일이 아닙니다."));const i=new Image();i.onload=()=>ok(i);i.onerror=()=>no(new Error("이미지를 읽지 못했습니다."));i.src=URL.createObjectURL(f);});}
function putGpt(st,img){const k=gptKey();(GPTS[k]=GPTS[k]||{})[st]=img;}
