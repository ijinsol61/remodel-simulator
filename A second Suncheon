}
function extractJSON(t){const a=t.indexOf("{"),b=t.lastIndexOf("}");if(a<0||b<a)throw new Error("bad json");return JSON.parse(t.slice(a,b+1));}
async function askClaude(prompt,blob){
  const opts={images:[blob],modelTier:"default"};
  if(typeof SAMPLE.json==="function"){
    try{return await SAMPLE.json(prompt,opts);}catch(e){if(e&&e.code)throw e;}
  }
  const r=await SAMPLE(prompt,opts);return extractJSON(r.text||"");
}
async function initClaude(tries){
  try{
    if(!(window.claude&&typeof window.claude.use==="function")){if((tries||0)<6)setTimeout(()=>initClaude((tries||0)+1),500);return;}
    const sm=await window.claude.use("sample");if(!sm)return;
    let ok=true;try{const l=await sm.limits();ok=!!(l&&l.images);}catch(e){ok=true;}
    if(ok){SAMPLE=sm;updatePill();refresh();}
  }catch(e){}
}
function updatePill(){
  $("aikit").hidden=!!API.ready;document.querySelectorAll(".qact").forEach(e=>e.hidden=!!API.ready);
  if(API.ready){$("promptLbl").textContent="아래 문장이 업로드한 원본 사진과 함께 서버를 거쳐 OpenAI 이미지 편집 API로 전달됩니다. 문장은 prompts.js 파일에서 고칠 수 있습니다.";$("qNote").textContent="스타일마다 한 번씩 [리모델링 이미지 만들기]를 누른 뒤 이 버튼을 누르면 현재 사진과 세 가지 스타일 결과를 나란히 모읍니다.";}
