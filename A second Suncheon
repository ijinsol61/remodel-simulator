  $("exBeforeFile").addEventListener("change",async e=>{const f=e.target.files[0];e.target.value="";if(!f)return;const i=await loadImg(URL.createObjectURL(f));S.exLocal={id:"local",title:"직접 불러온 예시",before:"",beforeImg:i,afterImg:{},after:{},source:"ChatGPT"};S.source="ex:local";showExample();});
