  $("modePill").textContent=API.ready?"AI 연결됨 · OpenAI "+(API.model||""):SAMPLE?"AI 연결됨 · Claude 구조 분석":"시연용 · AI 연결 전";
}
async function checkApi(){
  try{
    if(location.protocol==="file:")throw 0;
    const r=await fetch("/api/remodel",{method:"GET",cache:"no-store"});
    if(!r.ok)throw 0;
    const j=await r.json();
    API={ready:!!j.ready,needsCode:!!j.needsCode,model:j.model};
  }catch(e){API={ready:false,needsCode:false};}
  $("codebox").hidden=!(API.ready&&API.needsCode);
  updatePill();
}
function saveCompare(){
  const R=S.result;if(!R)return;
  const W=1200,H=800,pad=60,c=document.createElement("canvas");c.width=W*2+30;c.height=H+pad*2;
  const x=c.getContext("2d");x.fillStyle="#fafbf8";x.fillRect(0,0,c.width,c.height);
  x.drawImage($("cvBefore"),0,pad);x.drawImage($("cvAfter"),W+30,pad);
  x.fillStyle="#1c2427";x.font="600 28px 'IBM Plex Sans KR',sans-serif";
  x.fillText("BEFORE",0,40);x.fillText("AFTER · "+SCENARIOS[R.scenario].name+" · "+STYLES[R.style].name,W+30,40);
  x.font="22px 'IBM Plex Sans KR',sans-serif";x.fillStyle="#5b676a";
  const rl=S.real&&S.real.done?"실사 렌더(광선 추적) · ":"";
  const tag=R.ai&&R.aiSrc==="ChatGPT"?"AI 생성 이미지 (ChatGPT 앱으로 변환"+(R.checked?", Claude 안전 점검 통과":"")+") · 참고용, 실제 시공은 전문가 검토 필요":R.preset?"사전 생성 예시 ("+(R.exSrc||"ChatGPT")+"로 미리 만든 AI 이미지) · 실시간 생성 결과 아님 · 참고용":R.ai&&R.aiSrc&&R.aiSrc!=="Gemini"?"AI 생성 이미지 ("+R.aiSrc+" 이미지 편집, 안전 검사 통과) · 참고용, 실제 시공은 전문가 검토 필요":R.ai?(R.aiSrc?"AI 생성 이미지 ("+R.aiSrc+"로 실사화, 배치는 3D 모델 기준) · 참고용, 실제 시공은 전문가 검토 필요":"AI 생성 이미지 (OpenAI 이미지 모델) · 참고용, 실제 시공은 전문가 검토 필요"):R.engine==="claude"?rl+"AI 구조 분석 기반 (Claude 분석) · 참고용, 실제 시공은 전문가 검토 필요":rl+"예시 공간 데모 · AI 변환 아님";
  x.fillText(tag,W+30,H+pad+38);
  const fname="리모델링_비교_"+R.scenario+"_"+R.style+".png";
  c.toBlob(async b=>{
    try{if(window.claude&&typeof window.claude.use==="function"){const dl=await window.claude.use("downloads");if(dl){await dl.save({filename:fname,data:b});return;}}}catch(e){if(e&&e.code)return;}
    const a=document.createElement("a");a.href=URL.createObjectURL(b);a.download="리모델링_비교_"+R.scenario+"_"+R.style+".png";document.body.append(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},1000);},"image/png");
}

