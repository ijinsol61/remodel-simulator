function grade(src,dst,style){
  const G={nordic:{b:14,w:8,s:.84,c:.95},minimal:{b:22,w:-2,s:.68,c:.9},hanok:{b:6,w:18,s:.92,c:1.02}}[style];
  const d=src.getImageData(0,0,1200,800),a=d.data;
  for(let i=0;i<a.length;i+=4){
    let r=a[i],g=a[i+1],b=a[i+2];
    r=(r-128)*G.c+128+G.b;g=(g-128)*G.c+128+G.b;b=(b-128)*G.c+128+G.b;
    const l=.299*r+.587*g+.114*b;r=l+(r-l)*G.s;g=l+(g-l)*G.s;b=l+(b-l)*G.s;
    r+=G.w;g+=G.w*.25;b-=G.w*.8;
