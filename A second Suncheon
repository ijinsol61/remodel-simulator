async function copyText(t){try{await navigator.clipboard.writeText(t);return true;}catch(e){return false;}}
const GPTS={};
/* 올린 ChatGPT 결과를 Claude로 점검: 사람·로고·글자·선정성이 있으면 표시하지 않음 */
async function checkResult(file){
  if(!SAMPLE)return{checked:false};
  try{const j=await askClaude('Inspect this interior image for a student remodeling demo. Return ONLY JSON {"person":bool,"logo":bool,"text":bool,"sexual":bool,"interior":bool}. person = any human or body part (also in mirrors, pictures, screens). logo = any brand logo or trademark. text = readable letters, words or numbers. sexual = any nudity or suggestive content. interior = it is a photo of a room interior.',file);
    const hits=[["person","사람"],["logo","로고"],["text","글자"],["sexual","선정적 내용"]].filter(([k])=>j&&j[k]===true).map(([,v])=>v);
    if(j&&j.interior===false)hits.push("실내 사진 아님");
    return hits.length?{blocked:true,checked:true,msg:"점검 결과 "+hits.join("·")+"이(가) 발견되었습니다."}:{checked:true};}
  catch(e){return{checked:false};}
}/* 사진별·스타일별 ChatGPT 결과 */
function gptKey(){return S.img?S.img.src+"|"+S.scenario:"";}
async function kitFor(st){
  if(S.source!=="upload"||!S.img){$("kitMsg").textContent="먼저 왼쪽 1단계에서 내 방 사진을 올려 주세요. (예시 그림은 ChatGPT 변환 대상이 아닙니다)";return;}
  const ok=await copyText(buildPrompt(S.scenario,st));
  const p=prepImage(S.img);const b=await (await fetch(p.data)).blob();
