    drawAfter();refresh();$("kitMsg").textContent=`'${STYLES[S.style].name}' 결과를 After에 넣었습니다.`+(chk.checked?" (사람·로고·글자·선정성 점검 통과)":" (자동 점검을 못 했으니 사람·로고·글자가 없는지 직접 확인해 주세요)")+" 다른 스타일도 만들면 [4안 비교]에 모입니다.";}
  catch(err){$("kitMsg").textContent=err.message;}});
document.querySelectorAll("[data-qk]").forEach(b=>b.addEventListener("click",()=>{kitFor(QSTY[+b.dataset.qk-1]);$("qNote").textContent=$("kitMsg").textContent||"내 방 사진을 먼저 올려 주세요.";}));
