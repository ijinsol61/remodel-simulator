const {SCENARIOS,STYLES,buildPrompt,buildRenderPrompt}=window.REMODEL;
const SAMPLES={
  A:{name:"노후주택 거실",dwg:"A-01",dims:"W 3,600 × D 4,200 × CH 2,400 (mm)"},
  B:{name:"원룸",dwg:"B-01",dims:"W 3,600 × D 4,200 × CH 2,400 (mm)"}
};

/* ---------- 그리기 도구 ---------- */
let K=700,CX=600,CY=385,EYE=1200,XC=0,XL=-1800,XR=1800;const YC=2400,ZB=4200,ZF=480;
const GEO0={K:700,CX:600,CY:385,EYE:1200,XC:0,XL:-1800,XR:1800};
function setGeo(g){K=g.K;CX=g.CX;CY=g.CY;EYE=g.EYE;XC=g.XC;XL=g.XL;XR=g.XR;}
let REC=null,TAG="";
const P=(x,y,z)=>{const p=[CX+(x-XC)*K/z, CY-(y-EYE)*K/z];if(REC){p.w=[x,y,z];if(!REC.geo)REC.geo={K,CX,CY,EYE,XC,XL,XR};}return p;};
function rgb(h){h=h.replace("#","");return[parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)];}
function shade(c,f){
  if(c[0]!=="#")return c;
  const k=v=>Math.max(0,Math.min(255,Math.round(f>1?v+(255-v)*(f-1)*1.6:v*f)));
  const[r,g,b]=rgb(c);return`rgb(${k(r)},${k(g)},${k(b)})`;
}
function poly(ctx,pts,fill,stroke,lw){
  if(REC){if(fill&&pts.every(p=>p.w))REC.items.push({k:"p",v:pts.map(p=>p.w),c:fill,tag:TAG});return;}
  ctx.beginPath();ctx.moveTo(pts[0][0],pts[0][1]);
  for(let i=1;i<pts.length;i++)ctx.lineTo(pts[i][0],pts[i][1]);
  ctx.closePath();
  if(fill){ctx.fillStyle=fill;ctx.fill();}
  if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=lw||1;ctx.stroke();}
}
function line(ctx,a,b,c,lw){if(REC){if(a.w&&b.w&&TAG!=="nofloor"){const q=parseCol(c);if(q[3]<.2)return;let dax=0;for(let k=0;k<3;k++)if(Math.abs(a.w[k]-b.w[k])>1)dax++;if(dax>1)return;const m=x=>Math.round(255*(x*q[3]+.42*(1-q[3])));const A=a.w,B=b.w,e=4;
    REC.items.push({k:"b",b:[Math.min(A[0],B[0])-e,Math.max(A[0],B[0])+e,Math.min(A[1],B[1])-e,Math.max(A[1],B[1])+e,Math.min(A[2],B[2])-e,Math.max(A[2],B[2])+e],c:`rgb(${m(q[0])},${m(q[1])},${m(q[2])})`,tag:""});}return;}ctx.beginPath();ctx.moveTo(a[0],a[1]);ctx.lineTo(b[0],b[1]);ctx.strokeStyle=c;ctx.lineWidth=lw||1;ctx.stroke();}
function box(ctx,b,c,stroke){
  if(REC){P(b[0],b[2],b[4]);REC.items.push({k:"b",b:b.slice(),c,tag:TAG});return;}
  const[x0,x1,y0,y1,z0,z1]=b;const st=stroke===undefined?"rgba(0,0,0,.16)":stroke;
  if(x1<XC)poly(ctx,[P(x1,y0,z0),P(x1,y0,z1),P(x1,y1,z1),P(x1,y1,z0)],shade(c,.84),st);
  else if(x0>XC)poly(ctx,[P(x0,y0,z0),P(x0,y0,z1),P(x0,y1,z1),P(x0,y1,z0)],shade(c,.84),st);
  if(y1<EYE)poly(ctx,[P(x0,y1,z0),P(x1,y1,z0),P(x1,y1,z1),P(x0,y1,z1)],shade(c,1.07),st);
  else if(y0>EYE)poly(ctx,[P(x0,y0,z0),P(x1,y0,z0),P(x1,y0,z1),P(x0,y0,z1)],shade(c,.8),st);
  poly(ctx,[P(x0,y0,z0),P(x1,y0,z0),P(x1,y1,z0),P(x0,y1,z0)],c,st);
}
function disc(ctx,cx,y,cz,r,fill,stroke){
  if(REC){const v=[];for(let i=0;i<20;i++){const a=i/20*Math.PI*2;v.push([cx+Math.cos(a)*r,y,cz+Math.sin(a)*r]);}P(cx,y,cz);REC.items.push({k:"p",v,c:fill,tag:TAG});return;}
  const l=P(cx-r,y,cz),rr=P(cx+r,y,cz),f=P(cx,y,cz-r),b=P(cx,y,cz+r);
  ctx.beginPath();ctx.ellipse((l[0]+rr[0])/2,(f[1]+b[1])/2,Math.abs(rr[0]-l[0])/2,Math.max(1,Math.abs(f[1]-b[1])/2),0,0,Math.PI*2);
  ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=1;ctx.stroke();}
}
function blob(ctx,p,r,c){if(REC)return;const g=ctx.createRadialGradient(p[0],p[1],0,p[0],p[1],r);g.addColorStop(0,c);g.addColorStop(1,c.replace(/[\d.]+\)$/,"0)"));ctx.fillStyle=g;ctx.beginPath();ctx.arc(p[0],p[1],r,0,Math.PI*2);ctx.fill();}
function rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function leaves(ctx,x,y,z,r,c){const s=K/z;const R=rng(Math.round(x+z));for(let i=0;i<9;i++){const a=R()*Math.PI*2,d=R()*r*.55;if(REC){REC.items.push({k:"s",o:[x+Math.cos(a)*d,y+Math.abs(Math.sin(a))*d*.9,z],r:r*.36,c:i%2?c:shade(c,.82),tag:""});continue;}const p=P(x+Math.cos(a)*d,y+Math.abs(Math.sin(a))*d*.9,z);ctx.beginPath();ctx.ellipse(p[0],p[1],r*.42*s,r*.3*s,a,0,Math.PI*2);ctx.fillStyle=i%2?c:shade(c,.82);ctx.fill();}}

const PAL={
  before:{wall:"#d8c89b",ceil:"#d6cfb6",floor:"#8b6a45",fl:"rgba(40,25,10,.35)",base:"#5a3e27",frame:"#9aa1a4",glass:["#b9c5c7","#a7b3b5"],fabric:"#6d4a34",wood:"#5b3d27",woodL:"#7a5a3e",white:"#cfc8b4",accent:"#7d6b5c"},
  nordic:{wall:"#f3efe7",ceil:"#faf9f6",floor:"#c79c66",fl:"rgba(120,85,40,.22)",base:"#f5f4f0",frame:"#fbfbfa",glass:["#eaf2f4","#d2e0e5"],fabric:"#bfc1bd",wood:"#c39761",woodL:"#d9b98a",white:"#f6f4f0",accent:"#93a58a",accentWall:"#b8c3ad"},
  minimal:{wall:"#f4f4f2",ceil:"#fbfbfa",floor:"#d8d4cc",fl:"rgba(90,85,75,.14)",base:"#f4f4f2",frame:"#f2f2f0",glass:["#eef4f6","#d9e5e9"],fabric:"#dedbd4",wood:"#bdb8ae",woodL:"#e6e3dc",white:"#efeeea",accent:"#8f8b84"},
  hanok:{wall:"#eee3cd",ceil:"#e6d6b8",floor:"#ad7a46",fl:"rgba(70,40,15,.30)",base:"#6a4528",frame:"#6b4a2e",glass:["#f6efdf","#efe4cd"],fabric:"#d9cdb3",wood:"#7a5233",woodL:"#a8794d",white:"#f3efe6",accent:"#3f5f63"}
};
const WIN={A:[-700,700,900,2100],B:[100,1400,900,2000]};

function shell(ctx,pal,st,room){
  // camera turned toward one side wall: the opposite side wall is out of view, so extend floor/ceiling/back wall past it
  const hideL=XC<XL+50,hideR=XC>XR-50,XLe=hideL?XL-8000:XL,XRe=hideR?XR+8000:XR;
  if(REC){REC.room={XL,XR,XLe,XRe,hideL,hideR,pal,st};TAG="ceil";poly(ctx,[P(XLe,YC,ZB),P(XRe,YC,ZB),P(XRe,YC,ZF),P(XLe,YC,ZF)],pal.ceil);TAG="floor";poly(ctx,[P(XLe,0,ZB),P(XRe,0,ZB),P(XRe,0,ZF),P(XLe,0,ZF)],pal.floor);TAG="wall";
    if(!hideL)poly(ctx,[P(XL,0,ZF),P(XL,0,ZB),P(XL,YC,ZB),P(XL,YC,ZF)],pal.wall);if(!hideR)poly(ctx,[P(XR,0,ZF),P(XR,0,ZB),P(XR,YC,ZB),P(XR,YC,ZF)],pal.wall);
    poly(ctx,[P(XLe,0,ZB),P(XRe,0,ZB),P(XRe,YC,ZB),P(XLe,YC,ZB)],pal.wall);TAG="";}else{
  poly(ctx,[P(XLe,YC,ZB),P(XRe,YC,ZB),P(XRe,YC,ZF),P(XLe,YC,ZF)],shade(pal.ceil,.96));
  poly(ctx,[P(XLe,0,ZB),P(XRe,0,ZB),P(XRe,0,ZF),P(XLe,0,ZF)],pal.floor);
  if(!hideL)poly(ctx,[P(XL,0,ZF),P(XL,0,ZB),P(XL,YC,ZB),P(XL,YC,ZF)],shade(pal.wall,.9));
  if(!hideR)poly(ctx,[P(XR,0,ZF),P(XR,0,ZB),P(XR,YC,ZB),P(XR,YC,ZF)],shade(pal.wall,.85));
  poly(ctx,[P(XLe,0,ZB),P(XRe,0,ZB),P(XRe,YC,ZB),P(XLe,YC,ZB)],pal.wall);}
  // 바닥
  if(REC){}else if(st==="before"){
    for(let x=XLe;x<=XRe;x+=450)line(ctx,P(x,0,ZB),P(x,0,ZF),pal.fl,1);
    for(let z=ZB;z>ZF;z-=450)line(ctx,P(XLe,0,z),P(XRe,0,z),pal.fl,1);
    blob(ctx,P(0,0,2600),170,"rgba(220,200,160,.25)");
  }else{
    const w=st==="minimal"?260:st==="hanok"?150:190;let i=0;
    for(let x=XLe;x<XRe;x+=w,i++){
      line(ctx,P(x,0,ZB),P(x,0,ZF),pal.fl,1);
      for(let z=ZB-((i*730)%1800);z>ZF;z-=1800)line(ctx,P(x,0,z),P(Math.min(x+w,XRe),0,z),pal.fl,1);
    }
  }
  const fg=ctx.createLinearGradient(0,585,0,900);fg.addColorStop(0,"rgba(0,0,0,.10)");fg.addColorStop(1,"rgba(0,0,0,0)");
  if(!REC)poly(ctx,[P(XLe,0,ZB),P(XRe,0,ZB),P(XRe,0,ZF),P(XLe,0,ZF)],fg);
  // 노후 벽지
  if(st==="before"&&!REC){
    for(let x=Math.max(XLe,XL-3000);x<=Math.min(XRe,XR+3000);x+=120)line(ctx,P(x,0,ZB),P(x,YC,ZB),"rgba(110,85,40,.07)",1);
    for(let z=ZB;z>ZF;z-=240){if(!hideL)line(ctx,P(XL,0,z),P(XL,YC,z),"rgba(110,85,40,.07)",1);if(!hideR)line(ctx,P(XR,0,z),P(XR,YC,z),"rgba(110,85,40,.07)",1);}
